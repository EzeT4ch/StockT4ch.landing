# URLs y contacto públicos (reemplazar con valores reales)
SITE_DOMAIN=stocktech.com.ar
PUBLIC_SITE_URL=https://stocktech.com.ar
PUBLIC_APP_URL=https://app.stocktech.com.ar
# Botones Ingresar/Registrarse hacia el producto (false = la landing se ve como antes)
APP_LINKS_ENABLED=false
PUBLIC_CONTACT_EMAIL=contacto@stocktech.com.ar
PUBLIC_WHATSAPP_NUMBER=5491112345678

# Estado comercial
SITE_MODE=prelaunch
TRIAL_DAYS=15
FOUNDERS_SLOTS=10
FOUNDERS_DISCOUNT=20

# Precios mensuales en ARS (enteros > 0). Obligatorios en producción, sin valor por defecto.
PRICE_COMERCIO_ARS_MONTHLY=34900
PRICE_NEGOCIO_ARS_MONTHLY=54900
PRICE_EMPRESA_ARS_MONTHLY=89900

# Experimento hero_copy_v1
EXPERIMENTS_ENABLED=true
EXPERIMENT_HERO_ENABLED=true
EXPERIMENT_HERO_WEIGHT_A=50
EXPERIMENT_HERO_WEIGHT_B=50

# Analytics (los proveedores requieren consentimiento)
ANALYTICS_ENABLED=false
ANALYTICS_DEBUG=false
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Datos que deben figurar en los textos legales antes de publicar
LEGAL_DATA_CONTROLLER_NAME=REEMPLAZAR-razon-social
LEGAL_ADDRESS=REEMPLAZAR-domicilio-legal
LEGAL_JURISDICTION=Argentina
LEGAL_LAST_UPDATED=2026-08-26
LEGAL_PRIVACY_VERSION=v1.0
LEAD_RETENTION_MONTHS=12

# Destino de leads — Resend SMTP. Verificá el dominio remitente y usá una API key con permiso sending_access.
LEAD_EMAIL_TO=leads@stocktech.com.ar
LEAD_EMAIL_FROM=StockTech <noreply@stocktech.com.ar>
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=REEMPLAZAR-api-key-resend
SMTP_SECURE=true

NODE_ENV=production
NGINX_PORT=8080
