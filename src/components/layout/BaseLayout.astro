---
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '../../styles/global.css';
// Los pesos secundarios se piden después del primer render (ver el <link> con onload abajo)
// para que no compitan con el HTML en la carga inicial en mobile.
import interMedium from '@fontsource/inter/latin-500.css?url';
import interSemiBold from '@fontsource/inter/latin-600.css?url';
import monoMedium from '@fontsource/ibm-plex-mono/latin-500.css?url';
import monoSemiBold from '@fontsource/ibm-plex-mono/latin-600.css?url';
import { getRuntimeConfig } from '../../config/env';
import AnalyticsConsent from './AnalyticsConsent.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const { title, description, path = '/', noindex = false, structuredData } = Astro.props;
const config = getRuntimeConfig();
const secondaryFonts = [interMedium, interSemiBold, monoMedium, monoSemiBold];
const secondaryFontLinks = secondaryFonts.map((href) => `<link rel="stylesheet" href="${href}" media="print" onload="this.media='all'">`).join('')
  + `<noscript>${secondaryFonts.map((href) => `<link rel="stylesheet" href="${href}">`).join('')}</noscript>`;
const canonical = new URL(path, config.siteUrl).toString();
const analyticsConsentEnabled = config.analytics.enabled && Boolean(config.analytics.ga4MeasurementId || config.analytics.metaPixelId);
const pageStructuredData = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const allStructuredData = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'StockTech', url: config.siteUrl.toString(), logo: new URL('/favicon.svg', config.siteUrl).toString() },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'StockTech', url: config.siteUrl.toString(), inLanguage: 'es-AR' },
  ...pageStructuredData,
];
---

<!doctype html>
<html lang="es-AR" data-site-mode={config.commercial.mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBF8F3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fragment set:html={secondaryFontLinks} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="StockTech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-card.png', config.siteUrl).toString()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="StockTech, sistema de gestión para comercios" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/social-card.png', config.siteUrl).toString()} />
    <meta name="twitter:image:alt" content="StockTech, sistema de gestión para comercios" />
    {config.analytics.cloudflareWebAnalyticsToken && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: config.analytics.cloudflareWebAnalyticsToken })}></script>}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(allStructuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <AnalyticsConsent enabled={analyticsConsentEnabled} />
  </body>
</html>
