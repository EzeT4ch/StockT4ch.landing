---
interface Props { launched?: boolean }
const { launched = false } = Astro.props;
---
<section id="arca" class="section" aria-labelledby="arca-t">
  <div class="container payments-grid reveal">
    <div>
      <p class="eyebrow">Cobros y facturación</p>
      <h2 id="arca-t" class="display">Vendés. Cobrás. Facturás.<br /><span>Sin salir de StockTech.</span></h2>
      <p class="lead">La factura sale de la venta que acabás de hacer, con los datos que ya cargaste.</p>
      <p class="payment-question">¿Cómo te pagaron?</p>
      <div class="payment-chips"><span><i class="cash"></i>Efectivo</span><span><i class="mp"></i>Mercado Pago</span><span><i class="qr"></i>QR</span></div>
      <p class="subtle-copy">{launched ? 'Vamos a sumar más medios de pago.' : 'Más medios de pago próximamente.'}</p>
    </div>
    <div class="mockup arca-ticket-wrap">
      <div class="ticket arca-ticket">
        <div class="arca-row"><i>✓</i><p><b>Venta registrada</b><small>#VT-2049</small></p><strong>$ 74.700</strong></div>
        <div class="arca-row"><i>✓</i><p><b>Pago aprobado</b><small>Mercado Pago</small></p><strong>$ 74.700</strong></div>
        <div class="arca-row"><i>✓</i><p><b>Factura B</b><small>ARCA · 0001-00000149</small></p><strong>autorizada</strong></div>
      </div><div class="ticket-notch"></div>
    </div>
  </div>
</section>
