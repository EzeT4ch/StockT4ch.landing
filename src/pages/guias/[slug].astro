---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import LegalHeader from '../../components/layout/LegalHeader.astro';
import Footer from '../../components/layout/Footer.astro';
import { getGuideBySlug, getRelatedGuides } from '../../config/guides';
import { getRuntimeConfig } from '../../config/env';

const slug = Astro.params.slug ?? '';
const guide = getGuideBySlug(slug);
if (!guide) return Astro.redirect('/404', 302);

const config = getRuntimeConfig();
const canonical = new URL(`/guias/${guide.slug}`, config.siteUrl).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    dateModified: guide.updatedAt,
    datePublished: guide.updatedAt,
    mainEntityOfPage: canonical,
    author: { '@type': 'Organization', name: 'EzeTech' },
    publisher: { '@type': 'Organization', name: 'StockTech', url: config.siteUrl.toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: config.siteUrl.toString() },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: new URL('/guias', config.siteUrl).toString() },
      { '@type': 'ListItem', position: 3, name: guide.title, item: canonical },
    ],
  },
];
const relatedGuides = getRelatedGuides(guide);
const updatedAt = new Intl.DateTimeFormat('es-AR', { dateStyle: 'long' }).format(new Date(`${guide.updatedAt}T12:00:00`));
---

<BaseLayout title={`${guide.title} — StockTech`} description={guide.description} path={`/guias/${guide.slug}`} {structuredData}>
  <LegalHeader />
  <main id="contenido" class="guide-main container">
    <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/guias">Guías</a><span aria-hidden="true">/</span><span aria-current="page">{guide.title}</span></nav>
    <article>
      <header class="guide-header">
        <p class="eyebrow">Guía para comercios argentinos</p>
        <h1 class="display">{guide.title}</h1>
        <p class="lead">{guide.description}</p>
        <p class="guide-updated">Actualizada el {updatedAt}</p>
      </header>
      <div class="guide-content">
        <p class="guide-intro">{guide.intro}</p>
        {guide.sections.map((section) => <section>
          <h2 class="display">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>)}
      </div>
    </article>
    {guide.references && <section class="guide-references" aria-labelledby="fuentes-title"><h2 id="fuentes-title" class="display">Fuentes para ampliar</h2><ul>{guide.references.map((reference) => <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.label}</a></li>)}</ul></section>}
    {relatedGuides.length > 0 && <aside class="related-guides" aria-labelledby="related-title"><p class="eyebrow">Seguí leyendo</p><h2 id="related-title" class="display">Guías relacionadas</h2><ul>{relatedGuides.map((related) => <li><a href={`/guias/${related.slug}`}>{related.title}<span aria-hidden="true">→</span></a></li>)}</ul></aside>}
    <p class="guide-cta"><a class="button button-dark" href="/#sumate">Conocé StockTech</a></p>
  </main>
  <Footer whatsappUrl={config.whatsappUrl} />
</BaseLayout>
