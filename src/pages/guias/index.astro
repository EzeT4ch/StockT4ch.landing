---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import LegalHeader from '../../components/layout/LegalHeader.astro';
import Footer from '../../components/layout/Footer.astro';
import { guides } from '../../config/guides';
import { getRuntimeConfig } from '../../config/env';

const config = getRuntimeConfig();
const title = 'Guías para ordenar tu comercio — StockTech';
const description = 'Guías prácticas para comercios argentinos sobre stock, ventas, punto de venta, caja y facturación con ARCA.';
const formattedUpdatedAt = new Intl.DateTimeFormat('es-AR', { dateStyle: 'medium' });
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL('/guias', config.siteUrl).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, url: new URL(`/guias/${guide.slug}`, config.siteUrl).toString(), name: guide.title })),
  },
};
---

<BaseLayout {title} {description} path="/guias" {structuredData}>
  <LegalHeader />
  <main id="contenido" class="guides-main container">
    <p class="eyebrow">Guías StockTech</p>
    <h1 class="display">Herramientas para ordenar la operación diaria de tu comercio</h1>
    <p class="lead">Ideas prácticas sobre stock, ventas, caja y facturación para comercios argentinos. Publicamos contenido pensado para resolver tareas concretas, no promesas vacías.</p>
    <section class="guide-grid" aria-label="Guías disponibles">
      {guides.map((guide) => <article class="guide-card">
        <p class="eyebrow">Actualizada {formattedUpdatedAt.format(new Date(`${guide.updatedAt}T12:00:00`))}</p>
        <h2 class="display"><a href={`/guias/${guide.slug}`}>{guide.title}</a></h2>
        <p>{guide.description}</p>
        <a class="text-link" href={`/guias/${guide.slug}`}>Leer guía <span aria-hidden="true">→</span></a>
      </article>)}
    </section>
  </main>
  <Footer whatsappUrl={config.whatsappUrl} />
</BaseLayout>
